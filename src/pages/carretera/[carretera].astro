---
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import Fuente from '../../components/Fuente.astro';
import TablaEstaciones from '../../components/TablaEstaciones.astro';
import Mapa from '../../components/Mapa.astro';
import Calculadora from '../../components/Calculadora.astro';
import Anuncio from '../../components/Anuncio.astro';
import { carreterasPublicadas, provPorId, nacional, eur, comparar, titulo, nombreMunicipio, fechaLarga, stats, FECHA, NOMBRE } from '../../lib/datos.mjs';

export function getStaticPaths() {
  return carreterasPublicadas.map((c) => ({ params: { carretera: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const s = c.stats;
const principal = s.ga ? 'ga' : 'g95';
const carb = principal === 'ga' ? 'gasóleo A' : 'gasolina 95';
const conP = c.est.filter((e) => e[principal]);
const kmMin = c.est[0].km, kmMax = c.est.at(-1).km;
const nombreEst = (e) => (e.r.length <= 3 ? e.r : titulo(e.r));
const lugar = (e) => `${nombreMunicipio(e.m)}, ${provPorId[e.p].nombre}`;
const baratas = [...conP].sort((a, b) => a[principal] - b[principal]).slice(0, 5);
const dif = s[principal].max - s[principal].min;
// tramos por provincia, en el orden en que aparecen al recorrer los km
const tramos = c.provs.map((id) => {
  const est = c.est.filter((e) => e.p === id);
  return { p: provPorId[id], n: est.length, desde: est[0].km, hasta: est.at(-1).km, s: stats(est) };
});
const tramoBarato = tramos.filter((t) => t.s[principal] && t.n >= 2).sort((a, b) => a.s[principal].media - b.s[principal].media);
const km = (v) => v.toLocaleString('es-ES');
const title = `Gasolineras de la ${c.nombre}: precios hoy por kilómetro`;
const description = `Las ${c.est.length} gasolineras de la ${c.nombre} ordenadas por punto kilométrico, con el precio de hoy. ${NOMBRE[principal]} desde ${eur(s[principal].min)}/l en el km ${km(baratas[0].km)}.`;
---
<Base title={title} description={description}>
  <Migas items={[['Carreteras', '/carreteras/'], [c.nombre, c.url]]} />
  <h1>Gasolineras de la {c.nombre}: precio de hoy por punto kilométrico</h1>
  <p class="resumen">
    {`Hoy, ${fechaLarga(FECHA)}, hay `}<strong>{c.est.length} gasolineras</strong>{` en la ${c.nombre} entre el km ${km(kmMin)} y el km ${km(kmMax)}, repartidas por ${c.provs.length === 1 ? `la provincia de ${tramos[0].p.nombre}` : `${c.provs.length} provincias`}. `}
    {s.ga && <>El gasóleo A cuesta de media <strong>{eur(s.ga.media)}/l</strong> en la {c.nombre}, {comparar(s.ga.media, nacional.stats.ga.media, 'España')}. </>}
    {s.g95 && <>El precio medio de la gasolina 95 es <strong>{eur(s.g95.media)}/l</strong>, {comparar(s.g95.media, nacional.stats.g95.media, 'España')}. </>}
    La más barata para {carb} es <strong>{nombreEst(baratas[0])}</strong>, en el km {km(baratas[0].km)} ({lugar(baratas[0])}), a {eur(baratas[0][principal])}/l: {eur(dif)} menos por litro que la más cara de la vía, o {eur(dif * 50, 2)} en un depósito de 50 litros.
    {tramoBarato.length > 1 && <> Por provincias, el tramo más barato es el de {tramoBarato[0].p.nombre} ({eur(tramoBarato[0].s[principal].media)}/l de media) y el más caro, el de {tramoBarato.at(-1).p.nombre} ({eur(tramoBarato.at(-1).s[principal].media)}/l).</>}
  </p>
  <div class="cifras">
    {['ga', 'g95'].filter((f) => s[f]).map((f) => <div class="cifra"><small>{NOMBRE[f]} · media en la {c.nombre}</small><strong>{eur(s[f].media)}</strong><br /><em>mín. {eur(s[f].min)} · máx. {eur(s[f].max)}</em></div>)}
  </div>

  <h2>Las 5 gasolineras más baratas de la {c.nombre} ({carb})</h2>
  <ol>{baratas.map((e) => <li><strong>{eur(e[principal])}/l</strong>: {nombreEst(e)}, km {km(e.km)}{e.mg === 'D' ? ', margen derecho' : e.mg === 'I' ? ', margen izquierdo' : ''} ({lugar(e)})</li>)}</ol>

  {tramos.length > 1 && <>
    <h2>Precio de la {c.nombre} por provincia</h2>
    <div class="tabla"><table>
      <thead><tr><th>Provincia</th><th class="n">Tramo</th><th class="n">Gasolineras</th><th class="n">Gasóleo A</th><th class="n">Gasolina 95</th></tr></thead>
      <tbody>{tramos.map((t) => <tr><td><a href={t.p.url}>{t.p.nombre}</a></td><td class="n">km {km(t.desde)}–{km(t.hasta)}</td><td class="n">{t.n}</td><td class="n">{t.s.ga ? eur(t.s.ga.media) : '—'}</td><td class="n">{t.s.g95 ? eur(t.s.g95.media) : '—'}</td></tr>)}</tbody>
    </table></div>
  </>}
  <Anuncio />

  <h2>Todas las gasolineras de la {c.nombre}, por punto kilométrico</h2>
  <p>El margen indica a qué lado de la carretera está la gasolinera según el sentido en que aumentan los kilómetros (margen derecho = a la derecha si circulas hacia kilómetros crecientes).</p>
  <TablaEstaciones est={c.est} conMunicipio conKm />
  <Mapa est={c.est} zona={`la ${c.nombre}`} principal={principal} />

  <Calculadora stats={s} zona={`la ${c.nombre}`} />
  <Anuncio />
  <p><small>Incluimos las gasolineras cuya dirección oficial indica la {c.nombre} y el punto kilométrico. Puede haber otras junto a la vía registradas con otra dirección (por ejemplo, una calle o un polígono): las encontrarás en la página de su municipio o en el <a href="/buscador/">buscador por cercanía</a>.</small></p>
  <Fuente />
</Base>
