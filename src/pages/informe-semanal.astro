---
// Informe de la semana: estadísticas propias calculadas en cada build con el histórico oficial (últimos 7 días).
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Fuente from '../components/Fuente.astro';
import Grafico from '../components/Grafico.astro';
import Anuncio from '../components/Anuncio.astro';
import { provincias, marcas, municipios, dispersionMunicipal, MIN_GASOLINERAS_COMPARAR, num, nacional, serieNacional, serieProvincia, ultimosDias, variacion, eur, pct, media, fechaLarga, FECHA, NOMBRE } from '../lib/datos.mjs';

const desde = new Date(new Date(FECHA).getTime() - 7 * 864e5).toISOString().slice(0, 10);
const cent = (precio, v) => (precio - precio / (1 + v / 100)) * 100; // variación en céntimos a partir del % y el precio actual
const ranking = (f) => provincias.map((p) => ({ p, v: variacion(serieProvincia(p.id, f), 7), precio: p.stats[f]?.media }))
  .filter((x) => x.v != null && x.precio).sort((a, b) => b.v - a.v);
const rGa = ranking('ga'), rG95 = ranking('g95');
const vNac = { ga: variacion(serieNacional('ga'), 7), g95: variacion(serieNacional('g95'), 7) };
const sube = (v) => (v > 0 ? 'ha subido' : 'ha bajado');
const mGa = [...marcas].filter((m) => m.stats.ga).sort((a, b) => a.stats.ga.media - b.stats.ga.media);
// ahorro: mismo criterio que las guías (municipios con 5+ gasolineras con diésel; datos.mjs)
const ahorro = dispersionMunicipal.mediaMin, ahorroMax = dispersionMunicipal.maxMin;
const mayor = [...municipios.filter((m) => m.stats.ga?.n >= MIN_GASOLINERAS_COMPARAR)].sort((a, b) => (b.stats.ga.max - b.stats.ga.min) - (a.stats.ga.max - a.stats.ga.min)).slice(0, 5);
// tablas: 5 que más suben y 5 que más bajan (null = separador)
const tablas = [['el diésel', rGa], ['la gasolina 95', rG95]].map(([n, r]) => [n, [...r.slice(0, 5), null, ...r.slice(-5)]]);
// "del 9 al 16 de noviembre de 2026" (o con mes/año completo si la semana cruza de mes)
const rango = desde.slice(0, 7) === FECHA.slice(0, 7) ? `del ${+desde.slice(8)} al ${fechaLarga(FECHA)}` : `del ${fechaLarga(desde)} al ${fechaLarga(FECHA)}`;
const title = `Informe semanal de precios de la gasolina y el diésel, ${rango}`;
---
<Base title={title} description={`Qué provincias suben y bajan más esta semana, qué marcas son más baratas y cuánto se ahorra eligiendo bien la gasolinera. Datos oficiales ${rango}.`}>
  <Migas items={[['Informe semanal', '/informe-semanal/']]} />
  <h1>Informe semanal de precios de carburantes</h1>
  <p class="resumen">{rango[0].toUpperCase() + rango.slice(1)}, según los precios oficiales de las {nacional.stats.ga.n.toLocaleString('es-ES', { useGrouping: 'always' })} gasolineras con diésel de España.
    {vNac.ga != null && <> El gasóleo A {sube(vNac.ga)} un {pct(Math.abs(vNac.ga)).replace('+', '')} en la semana y cuesta de media <strong>{eur(nacional.stats.ga.media)}/l</strong>.</>}
    {vNac.g95 != null && <> La gasolina 95 {sube(vNac.g95)} un {pct(Math.abs(vNac.g95)).replace('+', '')} y su precio medio es <strong>{eur(nacional.stats.g95.media)}/l</strong>.</>}
    {rGa.length > 1 && <> Por provincias, donde {rGa[0].v > 0 ? 'más ha subido' : 'menos ha bajado'} el diésel es {rGa[0].p.nombre} ({pct(rGa[0].v)}) y donde {rGa.at(-1).v < 0 ? 'más ha bajado' : 'menos ha subido'}, {rGa.at(-1).p.nombre} ({pct(rGa.at(-1).v)}).</>}
    {' '}En los municipios con {MIN_GASOLINERAS_COMPARAR} o más gasolineras, repostar en la más barata en lugar de en una de precio medio ahorra de media <strong>{eur(ahorro)} por litro</strong> de diésel, {eur(ahorro * 50, 2)} en un depósito de 50 litros.</p>
  <div class="cifras">
    {(['ga', 'g95'] as const).map((f) => <div class="cifra"><small>{NOMBRE[f]} · media España</small><strong>{eur(nacional.stats[f].media)}</strong><br />{vNac[f] != null && <em class={vNac[f] > 0 ? 'sube' : 'baja'}>7 días {pct(vNac[f])}</em>}</div>)}
    <div class="cifra"><small>Ahorro medio por depósito</small><strong>{eur(ahorro * 50, 2)}</strong><br /><em>50 l de diésel, más barata vs. media local</em></div>
  </div>

  <Grafico titulo="Precio medio en España en los últimos 30 días" series={[{ nombre: 'Gasóleo A', puntos: ultimosDias(serieNacional('ga'), 30) }, { nombre: 'Gasolina 95', puntos: ultimosDias(serieNacional('g95'), 30) }]} />

  {tablas.map(([n, filas]) => <>
    <h2>Provincias donde más sube y más baja {n} esta semana</h2>
    <div class="tabla"><table>
      <thead><tr><th>Provincia</th><th class="n">Precio hoy</th><th class="n">7 días</th><th class="n">Por litro</th></tr></thead>
      <tbody>{filas.map((x) => x
        ? <tr><td><a href={x.p.url}>{x.p.nombre}</a></td><td class="n">{eur(x.precio)}</td><td class:list={['n', x.v > 0 ? 'sube' : 'baja']}>{pct(x.v)}</td><td class="n">{(x.v > 0 ? '+' : '') + cent(x.precio, x.v).toFixed(1).replace('.', ',')} cént.</td></tr>
        : <tr><td colspan="4"><small>…</small></td></tr>)}</tbody>
    </table></div>
  </>)}
  <Anuncio />

  <h2>Marcas más baratas hoy (gasóleo A)</h2>
  <ol>{mGa.slice(0, 5).map((m) => <li><a href={m.url}>{m.nombre}</a>: {eur(m.stats.ga.media)}/l de media en {num(m.est.length)} estaciones</li>)}</ol>
  <p>La más cara de las marcas con página propia es <a href={mGa.at(-1).url}>{mGa.at(-1).nombre}</a> ({eur(mGa.at(-1).stats.ga.media)}/l). La media de cada marca depende también de las provincias en las que está. <a href="/marcas/">Ver el ranking completo →</a></p>

  <h2>Cuánto se ahorra eligiendo gasolinera</h2>
  <p>En los {num(dispersionMunicipal.n)} municipios con {MIN_GASOLINERAS_COMPARAR} o más gasolineras con diésel, la diferencia media entre la más barata y la más cara es de {eur(ahorroMax)} por litro ({eur(ahorroMax * 50, 2)} por depósito). Donde más se nota hoy:</p>
  <ol>{mayor.map((m) => <li>{m.publicada ? <a href={m.url}>{m.nombre}</a> : m.nombre} ({provincias.find((p) => p.id === m.prov).nombre}): de {eur(m.stats.ga.min)} a {eur(m.stats.ga.max)}, {eur(m.stats.ga.max - m.stats.ga.min)} de diferencia</li>)}</ol>
  <p><small>Cómo se calcula: variación entre el precio medio oficial de hoy y el de hace 7 días; el ahorro compara, en cada municipio, la media de sus gasolineras con la más barata. Detalles en la <a href="/metodologia/">metodología</a>.</small></p>
  <Fuente />
</Base>
