---
import Base from '../../../layouts/Base.astro';
import Migas from '../../../components/Migas.astro';
import Fuente from '../../../components/Fuente.astro';
import Grafico from '../../../components/Grafico.astro';
import TablaEstaciones from '../../../components/TablaEstaciones.astro';
import Calculadora from '../../../components/Calculadora.astro';
import Anuncio from '../../../components/Anuncio.astro';
import { municipiosPublicados, munPorId, provPorId, ccaaPorId, municipios, serieMunicipio, serieProvincia, ultimosDias,
  variacion, eur, pct, comparar, tendencia, titulo, direccion, fechaLarga, FECHA, NOMBRE } from '../../../lib/datos.mjs';

export function getStaticPaths() {
  return municipiosPublicados.map((m) => ({ params: { prov: provPorId[m.prov].slug, mun: m.slug }, props: { id: m.id } }));
}
const m = munPorId[Astro.props.id];
const p = provPorId[m.prov];
const c = ccaaPorId[p.ccaa];
const s = m.stats;
const n = m.est.filter((e) => e.ga || e.g95 || e.g98 || e.glp).length; // solo las que publican algún precio de la tabla
const ref = p.ref; // "la provincia de X" o "la Comunidad de Madrid"
const principal = s.ga ? 'ga' : 'g95';
const sGa = serieMunicipio(m.id, 'ga'), sG95 = serieMunicipio(m.id, 'g95');
const tend = tendencia(serieMunicipio(m.id, principal));
// posición del municipio en su provincia (municipios con 2+ gasolineras), por precio medio
const rivales = municipios.filter((x) => x.prov === m.prov && x.stats[principal] && x.est.length >= 2)
  .sort((a, b) => a.stats[principal].media - b.stats[principal].media);
const puesto = rivales.findIndex((x) => x.id === m.id) + 1;
const vecinos = municipiosPublicados.filter((x) => x.prov === m.prov && x.id !== m.id).sort((a, b) => b.est.length - a.est.length).slice(0, 18);
const dif = (f) => (s[f] ? s[f].max - s[f].min : 0);
const nombreEst = (e) => (e.r.length <= 3 ? e.r : titulo(e.r));
const title = `Gasolineras baratas en ${m.nombre}${m.nombre !== p.nombre ? ` (${p.nombre})` : ''}: precios hoy`;
const description = `Precios de hoy en las ${n} gasolineras de ${m.nombre}: ${s.g95 ? `gasolina 95 desde ${eur(s.g95.min)}/l` : ''}${s.g95 && s.ga ? ' y ' : ''}${s.ga ? `diésel desde ${eur(s.ga.min)}/l` : ''}. Comparativa, evolución y calculadora de ahorro.`;
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'ItemList', name: `Gasolineras en ${m.nombre}`,
  itemListElement: m.est.slice(0, 30).map((e, i) => ({ '@type': 'ListItem', position: i + 1, item: {
    '@type': 'GasStation', name: `${nombreEst(e)} ${direccion(e.d)}`,
    address: { '@type': 'PostalAddress', streetAddress: direccion(e.d), postalCode: e.cp, addressLocality: m.nombre, addressRegion: p.nombre, addressCountry: 'ES' },
    ...(e.lat && e.lon ? { geo: { '@type': 'GeoCoordinates', latitude: e.lat, longitude: e.lon } } : {}),
  } })),
}];
---
<Base title={title} description={description} jsonld={jsonld} noindex={m.retirada}>
  <Migas items={[...(c.uni ? [] : [[c.nombre, c.url]]), [p.nombre, p.url], [m.nombre, m.url]]} />
  <h1>Gasolineras en {m.nombre}: precio de la gasolina y el diésel hoy</h1>
  <p class="resumen">
    {`Hoy, ${fechaLarga(FECHA)}, hay `}<strong>{n} gasolineras</strong>{` con precios publicados en ${m.nombre}${m.nombre !== p.nombre ? ` (${p.nombre})` : ''}.`}{m.est.length - n === 1 && ' Otra no publica precio de gasolina, diésel ni GLP.'}{m.est.length - n > 1 && ` Otras ${m.est.length - n} no publican precio de gasolina, diésel ni GLP.`}
    {s.ga && <>El gasóleo A cuesta de media <strong>{eur(s.ga.media)}/l</strong>, {comparar(s.ga.media, p.stats.ga?.media, ref)}. </>}
    {s.g95 && <>La gasolina 95 sale a <strong>{eur(s.g95.media)}/l</strong> de media, {comparar(s.g95.media, p.stats.g95?.media, ref)}. </>}
    {s[principal].n > 1 && <>La más barata para {principal === 'ga' ? 'diésel' : 'gasolina 95'} es <strong>{nombreEst(s[principal].barata)}</strong> ({direccion(s[principal].barata.d)}), a {eur(s[principal].min)}/l: {eur(dif(principal))} menos por litro que la más cara. </>}
    {tend && `El precio medio ${principal === 'ga' ? 'del gasóleo A' : 'de la gasolina 95'} en ${m.nombre} ${tend}.`}
  </p>
  <div class="cifras">
    {['g95', 'ga', 'g98', 'glp'].filter((f) => s[f]).map((f) => {
      const v = variacion(serieMunicipio(m.id, f), 7);
      return <div class="cifra"><small>{NOMBRE[f]} · media</small><strong>{eur(s[f].media)}</strong><br />
        <em>mín. {eur(s[f].min)}</em>{v != null && <em class={v > 0 ? 'sube' : 'baja'}> · 7 días {pct(v)}</em>}</div>;
    })}
    {puesto > 0 && <div class="cifra"><small>Puesto en {p.nombre}</small><strong>{puesto}.º de {rivales.length}</strong><br /><em>municipios más baratos ({principal === 'ga' ? 'diésel' : 'gasolina 95'})</em></div>}
  </div>

  <h2>Precios de todas las gasolineras de {m.nombre}</h2>
  <p>Ordenadas de más barata a más cara por gasóleo A. En verde, el precio más bajo de cada carburante.</p>
  <TablaEstaciones est={m.est} />
  <Anuncio />

  <h2>Evolución del precio en {m.nombre}</h2>
  <p>Precio medio diario según el histórico oficial del Ministerio (un dato por estación y día).</p>
  {sGa.length > 1 && <Grafico titulo={`Gasóleo A: ${m.nombre} frente a la media de ${ref}, últimos 90 días`}
    series={[{ nombre: m.nombre, puntos: ultimosDias(sGa, 90) }, { nombre: `Media de ${ref}`, puntos: ultimosDias(serieProvincia(p.id, 'ga'), 90) }]} />}
  {sG95.length > 1 && <Grafico titulo={`Gasolina 95: ${m.nombre} frente a la media de ${ref}, últimos 90 días`}
    series={[{ nombre: m.nombre, puntos: ultimosDias(sG95, 90) }, { nombre: `Media de ${ref}`, puntos: ultimosDias(serieProvincia(p.id, 'g95'), 90) }]} />}

  <Calculadora stats={s} zona={m.nombre} />
  <Anuncio />

  {vecinos.length > 0 && <>
    <h2>Otros municipios de {p.nombre}</h2>
    <ul class="rejilla">{vecinos.map((v) => <li><a href={v.url}>{v.nombre}</a> <small>({v.est.length} gasolineras{v.stats.ga && `, diésel ${eur(v.stats.ga.media)}`})</small></li>)}</ul>
    <p><a href={p.url}>Ver todos los precios de {p.nombre} →</a></p>
  </>}
  <Fuente />
</Base>
