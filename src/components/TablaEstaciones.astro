---
import { num, NOMBRE, eur, titulo, direccion, nombreMunicipio } from '../lib/datos.mjs';
interface Props { est: any[]; conMunicipio?: boolean; conKm?: boolean; max?: number }
const { est, conMunicipio = false, conKm = false, max = Infinity } = Astro.props;
const MARGEN = { D: 'margen derecho', I: 'margen izquierdo' };
const cols = ['g95', 'ga', 'g98', 'glp'].filter((f) => est.some((e) => e[f]));
const minimo = Object.fromEntries(cols.map((f) => [f, Math.min(...est.filter((e) => e[f]).map((e) => e[f]))]));
// con precio primero (ya vienen ordenadas por precio); las que no publican ninguno de estos carburantes, al final
const conPrecio = est.filter((e) => cols.some((f) => e[f]));
const sinPrecio = est.filter((e) => !cols.some((f) => e[f]));
const filas = [...conPrecio, ...sinPrecio].slice(0, max);
// Las primeras 25 a la vista; el resto (todas) en un desplegable: mismo HTML indexable, página más manejable en móvil
const grupos = [filas.slice(0, 25), filas.slice(25)].filter((g) => g.length);
const nombre = (e) => (e.r.length <= 3 ? e.r : titulo(e.r));
---
{cols.length > 2 && <p class="desliza">Desliza la tabla hacia la izquierda para ver todos los carburantes →</p>}
{grupos.map((g, gi) => {
  const tabla = <div class="tabla"><table>
  <thead><tr><th>Gasolinera</th>{cols.map((f) => <th class="n">{NOMBRE[f].replace(' (diésel)', '')}</th>)}</tr></thead>
  <tbody>{g.map((e) => (
    <tr>
      <td>{conKm && <><strong>km {e.km.toLocaleString('es-ES', { useGrouping: 'always' })}</strong>{MARGEN[e.mg] && ` · ${MARGEN[e.mg]}`}<br /></>}<strong>{nombre(e)}</strong><br /><small>{direccion(e.d)}{conMunicipio && ` · ${nombreMunicipio(e.m)}`}<br />Horario: {e.h}</small></td>
      {cols.some((f) => e[f])
        ? cols.map((f) => <td class:list={['n', { top1: e[f] && e[f] === minimo[f] }]}>{e[f] ? eur(e[f]) : '—'}</td>)
        : <td colspan={cols.length}><small>Sin precio publicado de estos carburantes</small></td>}
    </tr>))}
  </tbody>
</table></div>;
  return gi === 0 ? tabla : <details class="mas"><summary>Ver las otras {num(g.length)} gasolineras</summary>{tabla}</details>;
})}
{est.length > max && <p><small>Se muestran las {max} más baratas de {num(est.length)} gasolineras.</small></p>}
