# Copia este fichero a .env (que está en .gitignore) solo para pruebas locales.
# En producción estas variables van en GitHub → Settings → Secrets and variables → Actions → Variables.
SITE_URL=https://litrohoy.com
# ID de editor de AdSense (público, aparece en el HTML). Vacío = sin anuncios.
PUBLIC_ADSENSE_ID=
# ID del bloque de anuncios adaptable creado en AdSense. Vacío = sin bloques manuales.
PUBLIC_ADSENSE_SLOT=
